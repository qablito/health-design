{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@health-design/catalog/nutrition": ["./packages/catalog/src/nutrition/index.ts"],
      "@health-design/contracts": ["./packages/contracts/src/index.ts"],
      "@health-design/domain": ["./packages/domain/src/index.ts"],
      "@health-design/engine": ["./packages/engine/src/index.ts"],
      "@health-design/test-fixtures/nutrition": [
        "./packages/test-fixtures/src/nutrition/index.ts"
      ]
    },
    "types": ["node"]
  },
  "include": [
    "apps/web/src",
    "apps/web/vite.config.ts",
    "packages/*/src",
    "playwright.config.ts",
    "scripts/import-nutrition/index.ts",
    "supabase/functions/_shared/*.ts",
    "supabase/functions/_shared/generated/contracts.d.ts",
    "supabase/functions/_shared/turnstile.ts",
    "supabase/functions/access/index.ts",
    "supabase/functions/admin/index.ts",
    "supabase/functions/admin-reconciler/index.ts",
    "supabase/functions/catalogs/index.ts",
    "supabase/functions/catalogs/nutrition.ts",
    "supabase/functions/plans/index.ts",
    "supabase/functions/plans/lifecycle.ts",
    "supabase/functions/plans/questionnaire.ts",
    "supabase/functions/runtime-smoke/index.ts",
    "tests",
    "vitest.config.ts",
    "vitest.browser.config.ts"
  ]
}
