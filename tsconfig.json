{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@health-design/catalog/nutrition": ["./packages/catalog/src/nutrition/index.ts"],
      "@health-design/catalog/nutrition-generator": [
        "./packages/catalog/src/nutrition/generator-metadata.ts"
      ],
      "@health-design/catalog/products": ["./packages/catalog/src/products/index.ts"],
      "@health-design/contracts": ["./packages/contracts/src/index.ts"],
      "@health-design/domain": ["./packages/domain/src/index.ts"],
      "@health-design/engine": ["./packages/engine/src/index.ts"],
      "@health-design/engine/nutrition": [
        "./packages/engine/src/modules/nutrition/index.ts"
      ],
      "@health-design/export": ["./packages/export/src/index.ts"],
      "@health-design/export/*": ["./packages/export/src/*"],
      "@health-design/test-fixtures/nutrition": [
        "./packages/test-fixtures/src/nutrition/index.ts"
      ],
      "@health-design/test-fixtures/exports": [
        "./packages/test-fixtures/src/exports/index.ts"
      ],
      "@health-design/test-fixtures/nutrition-plan": [
        "./packages/test-fixtures/src/profiles/nutrition/index.ts"
      ],
      "@health-design/test-fixtures/products": [
        "./packages/test-fixtures/src/products/index.ts"
      ]
    },
    "types": ["node"]
  },
  "include": [
    "apps/web/src",
    "apps/web/vite.config.ts",
    "packages/*/src",
    "playwright.config.ts",
    "scripts/import-nutrition/**/*.ts",
    "supabase/functions/_shared/*.ts",
    "supabase/functions/_shared/generated/contracts.d.ts",
    "supabase/functions/_shared/generated/products.d.ts",
    "supabase/functions/_shared/turnstile.ts",
    "supabase/functions/access/index.ts",
    "supabase/functions/admin/index.ts",
    "supabase/functions/admin-reconciler/index.ts",
    "supabase/functions/catalogs/index.ts",
    "supabase/functions/catalogs/nutrition.ts",
    "supabase/functions/exports/**/*.ts",
    "supabase/functions/medications/**/*.ts",
    "supabase/functions/plans/**/*.ts",
    "supabase/functions/runtime-smoke/index.ts",
    "tests",
    "vitest.config.ts",
    "vitest.browser.config.ts"
  ]
}
